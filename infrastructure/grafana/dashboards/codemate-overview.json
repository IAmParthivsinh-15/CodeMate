{
  "uid": "codemate-overview",
  "title": "CodeMate overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "codemate"
