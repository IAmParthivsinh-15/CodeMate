# Used by docker-compose.yml (env_file). Copy to .env and fill in.
# Infrastructure URLs (MongoDB, Redis, Kafka, Qdrant) are set by docker-compose itself.
# Never commit .env.

# Required: generate each with `openssl rand -hex 32`
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Optional: code execution (RapidAPI Judge0 CE, or a self-hosted Judge0 URL with JUDGE0_RAPIDAPI_HOST empty)
JUDGE0_API_URL=
JUDGE0_API_KEY=
JUDGE0_RAPIDAPI_HOST=

# Optional: LLM provider for AI answers (none = deterministic, engine-grounded answers)
LLM_PROVIDER=none
LLM_MODEL=
GROQ_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=

# Optional: embeddings for the chess RAG (local works offline)
EMBEDDING_PROVIDER=local
