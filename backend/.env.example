# Backend configuration for local development: copy to backend/.env.
# Only MONGO_URL and the two JWT secrets are required. Everything else is
# optional; empty values select the in-process fallback. The full reference
# is backend/src/config/env.js. Never commit .env.

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=5050
# all | api | realtime | worker   (see docs/architecture/service-boundaries.md)
SERVICE_ROLE=all
# Workers to run when SERVICE_ROLE is worker/all (empty = all): analysis,ai,coding,analytics
WORKERS=
LOG_LEVEL=info
# Comma-separated allowed browser origins (required in production)
CORS_ORIGINS=
ENABLE_DEBUG_ROUTES=false
METRICS_ENABLED=true

# --- MongoDB (required) ---------------------------------------------------
MONGO_URL=mongodb://localhost:27017/codemate

# --- Auth (required; >= 16 chars, e.g. `openssl rand -hex 32`) ------------
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-to-another-long-random-string
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Stockfish --------------------------------------------------------------
# Defaults to backend/engine/stockfish(.exe)
STOCKFISH_PATH=
ENGINE_POOL_SIZE=2
ANALYSIS_DEPTH=14
AUTO_ANALYZE=true

# --- Redis (empty = in-memory, single process) ----------------------------
REDIS_URL=

# --- Kafka (empty = in-process event bus) ---------------------------------
KAFKA_BROKERS=
KAFKA_CLIENT_ID=codemate

# --- Vector DB (empty = in-memory index rebuilt from MongoDB) -------------
VECTOR_DB_URL=
VECTOR_DB_API_KEY=

# --- LLM gateway (none = deterministic, engine-grounded answers) ----------
# none | groq | nvidia | gemini
LLM_PROVIDER=none
# Default model for the provider; per-tier overrides below (check your provider's catalogue)
LLM_MODEL=
LLM_MODEL_SMALL=
LLM_MODEL_MEDIUM=
LLM_MODEL_LARGE=
LLM_TIMEOUT_MS=30000
GROQ_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=

# --- Embeddings for the chess RAG -----------------------------------------
# local | gemini | nvidia   (changing this re-embeds the corpus: npm run ingest)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=

# --- Judge0 (code execution; empty = submissions return 503) ---------------
JUDGE0_API_URL=
JUDGE0_API_KEY=
# RapidAPI host header, e.g. judge0-ce.p.rapidapi.com (inferred for rapidapi.com URLs; empty for self-hosted)
JUDGE0_RAPIDAPI_HOST=

# --- Scripts ----------------------------------------------------------------
# npm run seed:admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
