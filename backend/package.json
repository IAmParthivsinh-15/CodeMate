{
  "name": "backend",
  "version": "1.0.0",
  "description": "CodeMate backend: chess, coding and AI learning platform API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "start:api": "node src/entry/api.js",
    "start:realtime": "node src/entry/realtime.js",
    "start:worker": "node src/entry/worker.js",
    "start:otel": "node --import @opentelemetry/auto-instrumentations-node/register src/server.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "lint": "eslint .",
    "seed:admin": "node scripts/seed-superadmin.js",
    "seed:problems": "node scripts/seed-problems.js",
    "ingest": "node scripts/ingest-knowledge.js",
    "rag:eval": "node scripts/rag-eval.js",
    "stats:rebuild": "node scripts/rebuild-stats.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "chess.js": "^1.3.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.15.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
